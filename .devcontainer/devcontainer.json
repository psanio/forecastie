{
  "name": "Forecastie Android Backport Development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
    },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-gradle",
        "vscjava.vscode-java-pack"
        ],
      "settings": { "java.jdt.ls.java.home": "/usr/local/openjdk-21" }
      }
    },
  "postCreateCommand": "java -version && ./gradlew --version && sdkmanager --list",
  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gradle,target=/home/vscode/.gradle,type=bind,consistency=cached"
    ]
}
